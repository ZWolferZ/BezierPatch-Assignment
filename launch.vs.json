{
    "version": "0.2.1",
    "defaults": {},
    "configurations": [
        {
            "type": "cppdbg",
            "name": "Debug Bezier Patch",
            "project": "Windows Build\\build-debug\\debug\\BezierPatchWindowRelease.exe",
            "cwd": "${workspaceRoot}\\Windows Build\\build-debug\\debug",
            "program": "${workspaceRoot}\\Windows Build\\build-debug\\debug\\BezierPatchWindowRelease.exe",
            "args": [ "patch.txt" ],
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "externalConsole": true,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
